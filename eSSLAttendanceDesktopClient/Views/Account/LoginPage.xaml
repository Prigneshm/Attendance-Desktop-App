<Page
    x:Class="eSSLAttendanceDesktopClient.Views.Account.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loader="clr-namespace:eSSLAttendanceDesktopClient.CustomeControl"
    xmlns:local="clr-namespace:eSSLAttendanceDesktopClient.Views.Account"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:noti="clr-namespace:eSSLAttendanceDesktopClient.Views.Menu"
    Title="LoginPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="40">
            <Image Source="pack://application:,,,/Images/img_login.png" Stretch="Uniform" />
        </Border>

        <ScrollViewer Grid.Column="1">
            <Grid Grid.Column="1" Background="{StaticResource BgColor}">
                <Border Margin="50">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="150" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />

                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Image
                            Grid.Row="0"
                            Width="300"
                            Margin="0,0,0,0"
                            Source="pack://application:,,,/Images/img_logo.png"
                            Stretch="Uniform" />

                        <StackPanel Grid.Row="2">
                            <Label
                                Content="Login Account"
                                FontSize="20"
                                Foreground="White"
                                Style="{StaticResource lblSemiBold}" />
                            <Label
                                Content="Log In Manage Attendance Records"
                                FontSize="15"
                                Foreground="White"
                                Style="{StaticResource lblLstRegular}" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Margin="0,10">
                            <Label
                                Content="Email"
                                FontSize="16"
                                Style="{StaticResource lblSemiBold}" />
                            <Border
                                Height="50"
                                Margin="0"
                                Padding="5,0"
                                Background="{StaticResource ResourceKey=EntBdrBGColor}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="txtEmail"
                                        Grid.Column="0"
                                        Height="50"
                                        Margin="10,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="{StaticResource ResourceKey=EntBdrBGColor}"
                                        BorderThickness="0"
                                        FontSize="16"
                                        Foreground="{StaticResource PrimaryWhite}"
                                        KeyDown="txtEmail_KeyDown"
                                        Style="{StaticResource addEmpEntry}" />
                                    <Image
                                        Grid.Column="1"
                                        Width="30"
                                        Height="30"
                                        Source="pack://application:,,,/Images/icon_email.png" />

                                </Grid>
                            </Border>

                            <TextBlock
                                x:Name="EreEmail"
                                Grid.Row="2"
                                Foreground="Red"
                                Style="{StaticResource TextBlockRegular}"
                                Text="Please enter valid email address!"
                                Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel Grid.Row="6" Margin="0,10">
                            <Label
                                Content="Password"
                                FontSize="16"
                                Style="{StaticResource lblSemiBold}" />
                            <Border
                                Height="50"
                                Margin="0"
                                Padding="5,0"
                                Background="{StaticResource ResourceKey=EntBdrBGColor}"
                                BorderBrush="LightGray"
                                BorderThickness="0"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox
                                        x:Name="txtPassword"
                                        Grid.Column="0"
                                        Height="50"
                                        Margin="10,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="{StaticResource ResourceKey=EntBdrBGColor}"
                                        BorderThickness="0"
                                        FontSize="16"
                                        Foreground="{StaticResource PrimaryWhite}"
                                        KeyDown="txtPassword_KeyDown" />
                                    <Image
                                        Grid.Column="1"
                                        Width="30"
                                        Height="30"
                                        Source="pack://application:,,,/Images/icon_password.png" />
                                </Grid>
                            </Border>

                            <TextBlock
                                x:Name="ErePassword"
                                Grid.Row="2"
                                Foreground="Red"
                                Style="{StaticResource TextBlockRegular}"
                                Text="Please enter  password!"
                                Visibility="Collapsed" />
                        </StackPanel>

                        <!--#region [Remember Me / Forgot Password]-->
                        <Grid Grid.Row="8" Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                x:Name="stkRememberMe"
                                Grid.Column="0"
                                Mouse.MouseDown="stkRememberMe_MouseEnter"
                                Orientation="Horizontal">
                                <Image
                                    x:Name="imgCheckBox"
                                    Grid.Column="0"
                                    Width="25"
                                    Height="25"
                                    Source="pack://application:,,,/Images/icon_uncheckbox.png"
                                    Stretch="Uniform" />
                                <Label
                                    Grid.Column="1"
                                    Margin="5,0,0,0"
                                    VerticalContentAlignment="Center"
                                    Content="Remember me"
                                    FontSize="16"
                                    Foreground="{StaticResource PrimaryWhite}"
                                    MouseDoubleClick="Label_MouseDoubleClick"
                                    Style="{StaticResource lblRegular}" />
                            </StackPanel>

                            <Label
                                x:Name="lblForgotPassword"
                                Grid.Column="1"
                                HorizontalContentAlignment="Right"
                                Content="Forgot Pasword"
                                FontSize="18"
                                Foreground="#0B77A6"
                                Style="{StaticResource lblRegular}"
                                Visibility="Hidden" />
                        </Grid>

                        <Border
                            x:Name="bdrLogin"
                            Grid.Row="10"
                            Height="50"
                            Margin="0,20,0,0"
                            Background="{StaticResource AppButton2}"
                            CornerRadius="8"
                            Mouse.MouseDown="bdrLogin_MouseDown">
                            <Label
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="Login"
                                FontSize="18"
                                Foreground="{StaticResource PrimaryWhite}"
                                Style="{StaticResource lblSemiBold}" />
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                AutoReverse="False"
                                                Storyboard.TargetProperty="Opacity"
                                                From="0.1"
                                                To="0.9"
                                                Duration="0:0:1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <loader:CustomLoader
            x:Name="loaderView"
            Grid.ColumnSpan="2"
            Visibility="Hidden" />
    </Grid>
</Page>
