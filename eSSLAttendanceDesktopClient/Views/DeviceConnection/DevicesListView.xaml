                                                </Grid>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>-->

                        <DataGrid
                            x:Name="lstDevices"
                            Margin="0"
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            CanUserAddRows="False"
                            CanUserReorderColumns="False"
                            CanUserResizeColumns="False"
                            CanUserSortColumns="True"
                            ColumnHeaderStyle="{StaticResource CustomHeaderStyle}"
                            FontFamily="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Medium.ttf#Poppins Medium"
                            FontSize="14"
                            HeadersVisibility="Column"
                            HorizontalScrollBarVisibility="Auto"
                            IsHitTestVisible="True"
                            VerticalScrollBarVisibility="Auto">

                            <DataGrid.Columns>
                                <!--  Device Name  -->
                                <DataGridTemplateColumn Width="250">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock
                                                Margin="0,10,0,10"
                                                FontSize="16"
                                                Foreground="White"
                                                Style="{StaticResource TextBlockRegular}"
                                                Text="Device Name" />
                                            <Border
                                                Width="200"
                                                Height="40"
                                                BorderBrush="LightGray"
                                                BorderThickness="2"
                                                Style="{StaticResource bdrAddEmployee}">
                                                <TextBox
                                                    x:Name="txtDeviceName"
                                                    x:Uid="Name"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource addEmpEntry}"
                                                    TextChanged="DeviceNameFilter_TextChanged" />
                                            </Border>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Padding="10"
                                                Style="{StaticResource TextBlockRegular}"
                                                Text="{Binding Name}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--  IP Address  -->
                                <DataGridTemplateColumn Width="250">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock
                                                Margin="0,10"
                                                FontSize="16"
                                                Foreground="White"
                                                Style="{StaticResource TextBlockRegular}"
                                                Text="IP Address" />
                                            <Border
                                                Width="200"
                                                Height="40"
                                                BorderBrush="LightGray"
                                                BorderThickness="2"
                                                Style="{StaticResource bdrAddEmployee}">
                                                <TextBox
                                                    x:Name="txtIpAddress"
                                                    x:Uid="Name"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource addEmpEntry}"
                                                    TextChanged="IPAddressFilter_TextChanged" />
                                            </Border>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Padding="10"
                                                Style="{StaticResource TextBlockRegular}"
                                                Text="{Binding IPAddress}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--  Port  -->
                                <DataGridTemplateColumn Width="250">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Margin="0,10" Orientation="Vertical">
                                            <TextBlock
                                                Margin="0,10"
                                                FontSize="16"
                                                Foreground="White"
                                                Style="{StaticResource TextBlockRegular}"
                                                Text="Port" />
                                            <Border
                                                Width="200"
                                                Height="40"
                                                BorderBrush="LightGray"
                                                BorderThickness="2"
                                                Style="{StaticResource bdrAddEmployee}">
                                                <TextBox
                                                    x:Name="txtPort"
                                                    x:Uid="Name"
                                                    VerticalAlignment="Center"
                                                    DataObject.Pasting="NumericTextBox_Pasting"
                                                    PreviewKeyDown="NumericTextBox_PreviewKeyDown"
                                                    PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                    Style="{StaticResource addEmpEntry}"
                                                    TextChanged="PortFilter_TextChanged" />
                                            </Border>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Padding="10" Text="{Binding Port}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--  Status  -->
                                <DataGridTemplateColumn Width="250">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock
                                                Margin="0,10"
                                                FontSize="16"
                                                Foreground="White"
                                                Style="{StaticResource TextBlockRegular}"
                                                Text="Status" />

                                            <Border
                                                Width="200"
                                                Height="40"
                                                BorderBrush="LightGray"
                                                BorderThickness="2"
                                                Style="{StaticResource bdrAddEmployee}">
                                                <TextBox
                                                    x:Name="txtStatus"
                                                    x:Uid="Name"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource addEmpEntry}"
                                                    TextChanged="StatusFilter_TextChanged" />
                                            </Border>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Padding="10" Text="{Binding Status}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--  Action Column  -->
                                <DataGridTemplateColumn Width="250">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock
                                                Margin="0,10"
                                                HorizontalAlignment="Center"
                                                FontSize="16"
                                                Foreground="White"
                                                Style="{StaticResource TextBlockRegular}"
                                                Text="Action" />

                                            <Border
                                                Width="200"
                                                Height="40"
                                                BorderBrush="LightGray"
                                                BorderThickness="2"
                                                Style="{StaticResource bdrAddEmployee}"
                                                Visibility="Hidden">
                                                <TextBox
                                                    x:Name="txtAction"
                                                    x:Uid="Name"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource addEmpEntry}" />
                                            </Border>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--  Connect  -->
                                                <Border
                                                    Grid.Column="0"
                                                    Width="30"
                                                    Height="30"
                                                    HorizontalAlignment="Center"
                                                    Background="#0BA6F2"
                                                    CornerRadius="5"
                                                    PreviewMouseLeftButtonDown="BrdConnectDevice_PreviewMouseLeftButtonDown">
                                                    <Image
                                                        Width="20"
                                                        Height="20"
                                                        Source="pack://application:,,,/Images/icon_connection.png" />
                                                </Border>

                                                <!--  Delete  -->
                                                <Border
                                                    Grid.Column="2"
                                                    Width="30"
                                                    Height="30"
                                                    HorizontalAlignment="Center"
                                                    Background="#EC0A14"
                                                    CornerRadius="5">
                                                    <Image
                                                        Width="20"
                                                        Height="20"
                                                        MouseDown="BtnDelete_MouseDown"
                                                        Source="pack://application:,,,/Images/icon_delete.png" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                    </ScrollViewer>
                </Grid>

                <TextBlock
                    x:Name="lblRecordNotfound"
                    Grid.Row="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Foreground="Black"
                    Style="{StaticResource TextBlockRegular}"
                    Text="Record not found!"
                    Visibility="Hidden" />
            </Grid>

        </Border>
        <!--#endregion-->

        <Grid Grid.Row="7" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label
                x:Name="lblShowingRecords"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Content="Showing 1 to 2 of 10 Record"
                FontSize="16"
                Foreground="Black"
                Style="{StaticResource lblMedium}" />

            <ComboBox
                x:Name="cmbPageNumbers"
                Grid.Column="1"
                Width="80"
                DisplayMemberPath="PageNumber"
                SelectedValuePath="PageNumber"
                SelectionChanged="cmbPageNumbers_SelectionChanged"
                Visibility="Hidden" />


            <Border
                x:Name="btnPrevious"
                Grid.Column="3"
                Width="80"
                Height="30"
                CornerRadius="8"
                Mouse.MouseDown="btnPrevious_MouseDown">
                <Label
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{StaticResource AppButton2}"
                    Content="Previous"
                    Style="{StaticResource lblMedium}" />
                <Border.Triggers>
                    <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    AutoReverse="False"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0.1"
                                    To="0.9"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>

            <Border
                Grid.Column="5"
                Width="50"
                Height="30"
                Padding="0"
                Background="{StaticResource BGColor}"
                CornerRadius="5">
                <Label
                    x:Name="lblCurrentPageValue"
                    HorizontalContentAlignment="Center"
                    Style="{StaticResource lblMedium}" />
            </Border>

            <Border
                x:Name="btnNext"
                Grid.Column="7"
                Width="80"
                Height="30"
                CornerRadius="10"
                Mouse.MouseDown="btnNext_MouseDown">
                <Label
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{StaticResource AppButton2}"
                    Content="Next"
                    Style="{StaticResource lblMedium}" />
                <Border.Triggers>
                    <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    AutoReverse="False"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0.1"
                                    To="0.9"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>

        </Grid>

        <materialDesign:Snackbar
            Grid.RowSpan="9"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            FontWeight="Medium"
            MessageQueue="{x:Static Snackbar:SnackbarService.GlobalMessageQueue}" />
    </Grid>
</UserControl>
