                                                <TextBlock
                                                    Width="250"
                                                    Padding="10"
                                                    Style="{StaticResource ResourceKey=TextBlockRegular}"
                                                    Text="{Binding IPAddress}"
                                                    TextAlignment="Left" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn
                                        Width="250"
                                        Header=" Port"
                                        HeaderContainerStyle="{StaticResource HeaderStyle}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Width="250"
                                                    Padding="10"
                                                    Style="{StaticResource ResourceKey=TextBlockRegular}"
                                                    Text="{Binding Port}"
                                                    TextAlignment="Left" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn
                                        Width="250"
                                        Header=" Status"
                                        HeaderContainerStyle="{StaticResource HeaderStyle}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Width="250"
                                                    Padding="10"
                                                    Style="{StaticResource ResourceKey=TextBlockRegular}"
                                                    Text="{Binding Status}"
                                                    TextAlignment="Left" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn
                                        Width="250"
                                        Header="Action"
                                        HeaderContainerStyle="{StaticResource HeaderStyle}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Grid.Column="0"
                                                        Width="30"
                                                        Height="30"
                                                        HorizontalAlignment="Center"
                                                        Background="#EC0A14"
                                                        BorderThickness="0"
                                                        CornerRadius="5">
                                                        <Image
                                                            Width="20"
                                                            Height="20"
                                                            HorizontalAlignment="Center"
                                                            Mouse.MouseDown="BtnDelete_MouseDown"
                                                            Source="pack://application:,,,/Images/icon_delete.png" />
                                                        <Border.Triggers>
                                                            <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
                                                                            AutoReverse="False"
                                                                            Storyboard.TargetProperty="Opacity"
                                                                            From="0.1"
                                                                            To="0.9"
                                                                            Duration="0:0:1" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Border.Triggers>
                                                    </Border>

                                                    <Border
                                                        x:Name="BrdConnectDevice"
                                                        Grid.Column="2"
                                                        Width="30"
                                                        Height="30"
                                                        HorizontalAlignment="Center"
                                                        Background="#0BA6F2"
                                                        BorderThickness="0"
                                                        CornerRadius="5"
                                                        PreviewMouseLeftButtonDown="BrdConnectDevice_PreviewMouseLeftButtonDown">
                                                        <Image
                                                            x:Name="ImgConnectDevice"
                                                            Width="20"
                                                            Height="20"
                                                            HorizontalAlignment="Center"
                                                            Source="pack://application:,,,/Images/icon_connection.png" />
                                                        <Border.Triggers>
                                                            <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
                                                                            AutoReverse="False"
                                                                            Storyboard.TargetProperty="Opacity"
                                                                            From="0.1"
                                                                            To="0.9"
                                                                            Duration="0:0:1" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Border.Triggers>
