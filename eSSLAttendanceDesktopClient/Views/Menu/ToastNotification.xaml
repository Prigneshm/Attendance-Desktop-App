<UserControl
    x:Class="eSSLAttendanceDesktopClient.Views.Menu.ToastNotification"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:eSSLAttendanceDesktopClient.Views.Menu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Border
            Background="LightYellow"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="5">
            <TextBlock
                Name="ToastMessageTextBlock"
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="Toast Message" />
        </Border>
    </Grid>

</UserControl>
