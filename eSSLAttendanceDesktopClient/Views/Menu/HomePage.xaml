<Page
    x:Class="eSSLAttendanceDesktopClient.Views.Menu.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:li="http://github.com/zeluisping/loadingIndicators/xaml/controls"
    xmlns:loader="clr-namespace:eSSLAttendanceDesktopClient.CustomeControl"
    xmlns:local="clr-namespace:eSSLAttendanceDesktopClient.Views.Menu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <!--
        MouseEnter="OnMouseEnterHandler"
        MouseLeave="OnMouseLeaveHandler"
    -->
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Grid.Column="0"
                Margin="0"
                Background="{StaticResource BgColor}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image
                    Grid.Row="0"
                    Width="200"
                    Margin="0,20,0,50"
                    Source="pack://application:,,,/Images/img_logo.png"
                    Stretch="Uniform" />

                <Border
                    x:Name="bdrEmployee"
                    x:Uid="Employee"
                    Grid.Row="1"
                    Margin="0,0,15,0"
                    BorderThickness="0"
                    CornerRadius="0,8,8,0"
                    Mouse.MouseDown="bdrMenu_MouseDown">
                    <Grid Height="50" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="1"
                            Width="25"
                            Height="25"
                            Source="pack://application:,,,/Images/icon_employee.png"
                            Stretch="Uniform" />
                        <Label
                            x:Name="lblemploye"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Content="Employee"
                            FontSize="18"
                            Style="{StaticResource lblRegular}" />
                    </Grid>
                </Border>

                <!--#region [ Employee ]-->
                <Border
                    x:Name="bdrEmployee1"
                    x:Uid="Employee"
                    Grid.Row="1"
                    Margin="0,0,15,0"
                    BorderThickness="0"
                    CornerRadius="0,8,8,0"
                    Mouse.MouseDown="bdrMenu_MouseDown"
                    Visibility="Hidden">
                    <Grid Height="50" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="1"
                            Width="25"
                            Height="25"
                            Source="pack://application:,,,/Images/icon_employee.png"
                            Stretch="Uniform" />
                        <Label
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Content="Employee"
                            FontSize="18"
                            Style="{StaticResource lblRegular}" />
                    </Grid>
                </Border>
                <!--#endregion-->

                <!--#region [ Attendance Report ]-->
                <!--<Border
                    x:Name="bdrAttendanceReport"
                    x:Uid="Report"
                    Grid.Row="2"
                    Margin="0,0,15,0"
                    BorderThickness="0"
                    CornerRadius="0,8,8,0"
                    MouseDown="bdrMenu_MouseDown"
                    Visibility="Hidden">
                    <Grid Height="50" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="1"
                            Width="25"
                            Height="25"
                            Source="pack://application:,,,/Images/icon_report.png"
                            Stretch="Uniform" />
                        <Label
                            Grid.Column="2"
                            VerticalContentAlignment="Center"
                            Content="Attendance Report"
                            FontSize="18"
                            Style="{StaticResource lblRegular}" />
                    </Grid>
                </Border>-->
                <!--#endregion-->

                <!--#region [ Device ]-->
                <Border
                    x:Name="bdrDevice"
                    x:Uid="Device"
                    Grid.Row="3"
                    Margin="0,0,15,0"
                    BorderThickness="0"
                    CornerRadius="0,8,8,0"
                    MouseDown="bdrMenu_MouseDown">
                    <Grid Height="50" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="1"
                            Width="25"
                            Height="25"
                            Source="pack://application:,,,/Images/icon_connection.png"
                            Stretch="Uniform" />
                        <Label
                            x:Name="lblDevice"
                            Grid.Column="2"
                            VerticalContentAlignment="Center"
                            Content="Devices"
                            FontSize="18"
                            Style="{StaticResource lblRegular}" />
                    </Grid>
                </Border>
                <!--#endregion-->

                <!--#region [ Attendance Log ]-->
                <Border
                    x:Name="bdrAttendanceLog"
                    x:Uid="Attendance_Log"
                    Grid.Row="4"
                    Margin="0,0,15,0"
                    BorderThickness="0"
                    CornerRadius="0,8,8,0"
                    MouseDown="bdrMenu_MouseDown">
                    <Grid Height="50" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="1"
                            Width="25"
                            Height="25"
                            Source="pack://application:,,,/Images/icon_report.png"
                            Stretch="Uniform" />
                        <Label
                            x:Name="lblAttendance"
                            Grid.Column="2"
                            VerticalContentAlignment="Center"
                            Content="Attendance Log"
                            FontSize="18"
                            Style="{StaticResource lblRegular}" />
                    </Grid>
                </Border>
                <!--#endregion-->
            </Grid>

            <Border
                Grid.Column="1"
                Padding="15"
                Background="#D0D0D0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Column="4"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Right"
                        Background="{StaticResource AppButton2}"
                        CornerRadius="25">
                        <Image
                            x:Name="ImgLogout"
                            Width="25"
                            Height="25"
                            MouseLeftButtonDown="ImgLogout_MouseDown"
                            Source="pack://application:,,,/Images/icon_logout.png"
                            Stretch="Uniform" />
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            AutoReverse="False"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0.1"
                                            To="0.9"
                                            Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>

                    <Grid x:Name="grdViews" Grid.Row="1" />
                </Grid>

            </Border>

            <loader:CustomLoader
                x:Name="loaderView"
                Grid.ColumnSpan="2"
                Visibility="Hidden" />
        </Grid>
    </Grid>
</Page>
