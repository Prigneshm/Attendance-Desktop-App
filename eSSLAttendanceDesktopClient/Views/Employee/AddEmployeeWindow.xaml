<Window
    x:Class="eSSLAttendanceDesktopClient.Views.Employee.AddEmployeeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:eSSLAttendanceDesktopClient.Views.Employee"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="800"
    Height="650"
    Margin="0"
    Padding="0"
    BorderBrush="Transparent"
    BorderThickness="0"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">
    <Grid Margin="-2">
        <Border
            Margin="0"
            Padding="0"
            HorizontalAlignment="Stretch"
            Background="{StaticResource PrimaryWhite}"
            BorderThickness="2"
            CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--#region [ Navigation ]-->
                <Border
                    Grid.Row="0"
                    Padding="10"
                    Background="{StaticResource AppButton2}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label
                            x:Name="lblTitle"
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalContentAlignment="Center"
                            FontSize="16"
                            Foreground="{StaticResource PrimaryWhite}"
                            Style="{StaticResource lblSemiBold}" />
                        <Image
                            x:Name="imgClose"
                            Grid.Column="1"
                            Width="30"
                            Height="30"
                            Margin="0"
                            HorizontalAlignment="Right"
                            Mouse.MouseDown="imgClose_MouseDown"
                            Source="pack://application:,,,/Images/icon_close.png"
                            Visibility="Hidden" />
                    </Grid>
                </Border>
                <!--#endregion-->

                <Grid Grid.Row="1" Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--#region [ ROW - 0 ]-->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Label
                                Content="Employee ID"
                                FontSize="16"
                                Foreground="{StaticResource BgColor}"
                                Style="{StaticResource lblSemiBold}" />
                            <Label
                                Content="*"
                                FontSize="15"
                                Foreground="red"
                                Style="{StaticResource lblSemiBold}" />
                        </StackPanel>
                        <Border
                            BorderBrush="LightGray"
                            BorderThickness="2"
                            Style="{StaticResource bdrAddEmployee}">
                            <TextBox
                                x:Name="txtEmployeeID"
                                x:Uid="EmpID"
                                VerticalAlignment="Center"
                                Style="{StaticResource addEmpEntry}"
                                TextChanged="CommonText_ChangedEvent" />
                        </Border>
                        <TextBlock
                            x:Name="EreEmployeeId"
                            Foreground="Red"
                            Style="{StaticResource TextBlockRegular}"
                            Text="Please enter employee Id"
                            Visibility="Hidden" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <Label
                                Content="Select Department"
                                FontSize="16"
                                Foreground="{StaticResource BgColor}"
                                Style="{StaticResource lblSemiBold}" />
                            <Label
                                Content="*"
                                FontSize="15"
                                Foreground="red"
                                Style="{StaticResource lblSemiBold}" />
                        </StackPanel>
                        <Border
                            Margin="0,0"
                            BorderBrush="LightGray"
                            BorderThickness="2"
                            Style="{StaticResource bdrAddEmployee}">
                            <ComboBox
                                x:Name="CmboxDepartment"
                                x:Uid="DepartmentId"
                                Padding="10,0,0,0"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                DisplayMemberPath="Name"
                                SelectionChanged="CmboxDepartment_SelectionChanged"
                                Style="{StaticResource Cmbox}" />
                        </Border>
                        <TextBlock
                            x:Name="EreDepartment"
                            Foreground="Red"
                            Style="{StaticResource TextBlockRegular}"
                            Text="Please select department"
                            Visibility="Hidden" />
                    </StackPanel>


                    <!--#endregion-->

                    <!--#region [ ROW - 2 ]-->

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Label
                                Content="Select Designation"
                                FontSize="16"
                                Foreground="{StaticResource BgColor}"
                                Style="{StaticResource lblSemiBold}" />
                            <Label
                                Content="*"
                                FontSize="15"
                                Foreground="red"
                                Style="{StaticResource lblSemiBold}" />
                        </StackPanel>
                        <Border
                            x:Name="drdDesignationCmBox"
                            BorderBrush="LightGray"
                            BorderThickness="2"
                            Style="{StaticResource bdrAddEmployee}">
                            <ComboBox
                                x:Name="CmboxDesignation"
                                x:Uid="DesignationId"
                                Padding="10,0,0,0"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                DisplayMemberPath="Name"
                                SelectionChanged="CommonSelection_ChangedEvent"
                                Style="{StaticResource Cmbox}" />
                        </Border>

                        <TextBlock
                            x:Name="EreDesignation"
                            Foreground="Red"
                            Style="{StaticResource TextBlockRegular}"
                            Text="Please select designation"
                            Visibility="Hidden" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <Label
                                Content="Select Device"
                                FontSize="16"
                                Foreground="{StaticResource BgColor}"
                                Style="{StaticResource lblSemiBold}" />
                            <Label
                                Content="*"
                                FontSize="15"
                                Foreground="red"
                                Style="{StaticResource lblSemiBold}" />
                        </StackPanel>
                        <Border
                            x:Name="drdDeviceCmBox"
                            BorderBrush="LightGray"
                            BorderThickness="2"
                            Style="{StaticResource bdrAddEmployee}">
                            <ComboBox
                                x:Name="CmboxDevice"
                                x:Uid="DeviceId"
                                Padding="10,0,0,0"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                DisplayMemberPath="Name"
                                SelectionChanged="CommonSelection_ChangedEvent"
                                Style="{StaticResource Cmbox}" />
                        </Border>
                        <TextBlock
                            x:Name="EreDevice"
                            Foreground="Red"
                            Style="{StaticResource TextBlockRegular}"
                            Text="Please select device name"
                            Visibility="Hidden" />
                    </StackPanel>

                    <!--#endregion-->

                    <StackPanel Grid.Row="4" Grid.Column="0">
                        <StackPanel Margin="0" Orientation="Horizontal">
                            <Label
                                Content="First Name"
                                FontSize="16"
                                Foreground="{StaticResource BgColor}"
                                Style="{StaticResource lblSemiBold}" />
                            <Label
                                Content="*"
                                FontSize="15"
                                Foreground="Red"
                                Style="{StaticResource lblSemiBold}" />
                        </StackPanel>
                        <Border
                            BorderBrush="LightGray"
                            BorderThickness="2"
                            Style="{StaticResource bdrAddEmployee}">
                            <TextBox
                                x:Name="txtFirstName"
                                x:Uid="FName"
                                Style="{StaticResource addEmpEntry}"
                                TextChanged="CommonText_ChangedEvent" />
                        </Border>
                        <TextBlock
                            x:Name="EreFirstName"
                            Foreground="Red"
                            Style="{StaticResource TextBlockRegular}"
                            Text="Please enter first name"
                            Visibility="Hidden" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <Label
                            Content="Last Name"
                            FontSize="16"
                            Foreground="{StaticResource BgColor}"
                            Style="{StaticResource lblSemiBold}" />
                        <Border
                            BorderBrush="LightGray"
                            BorderThickness="2"
                            Style="{StaticResource bdrAddEmployee}">
                            <TextBox x:Name="txtLastName" Style="{StaticResource addEmpEntry}" />
                        </Border>
                    </StackPanel>

                    <!--#region [ ROW - 3  ]-->
                    <StackPanel Grid.Row="6" Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Label
                                Content="Contact"
                                FontSize="16"
                                Foreground="{StaticResource BgColor}"
                                Style="{StaticResource lblSemiBold}" />
                            <Label
                                Content="*"
                                FontSize="15"
                                Foreground="red"
                                Style="{StaticResource lblSemiBold}" />
                        </StackPanel>
                        <Border
                            BorderBrush="LightGray"
                            BorderThickness="2"
                            Style="{StaticResource bdrAddEmployee}">
                            <TextBox
                                x:Name="txtContact"
                                x:Uid="ContactNo"
                                MaxLength="10"
                                Style="{StaticResource addEmpEntry}"
                                TextChanged="CommonText_ChangedEvent" />
                        </Border>
                        <TextBlock
                            x:Name="EreContact"
                            Foreground="Red"
                            Style="{StaticResource TextBlockRegular}"
                            Text="Please enter 10 digit contect number"
                            Visibility="Hidden" />
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <Label
                                Content="Working Hours"
                                FontSize="16"
                                Foreground="{StaticResource BgColor}"
                                Style="{StaticResource lblSemiBold}" />
                            <Label
                                Content="*"
                                FontSize="15"
                                Foreground="red"
                                Style="{StaticResource lblSemiBold}" />
                        </StackPanel>
                        <Border
                            BorderBrush="LightGray"
                            BorderThickness="2"
                            Style="{StaticResource bdrAddEmployee}">
                            <ComboBox
                                x:Name="workingHoursComboBox"
                                x:Uid="WrokingHour"
                                Padding="10,0,0,0"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                SelectionChanged="CommonSelection_ChangedEvent"
                                Style="{StaticResource Cmbox}">
                                <ComboBoxItem Content="8 hour" />
                                <ComboBoxItem Content="10 hour" />
                                <ComboBoxItem Content="12 hour" />
                            </ComboBox>
                        </Border>
                        <TextBlock
                            x:Name="EreWorkingHours"
                            Foreground="Red"
                            Style="{StaticResource TextBlockRegular}"
                            Text="Please select last name"
                            Visibility="Hidden" />
                    </StackPanel>
                    <!--#endregion-->

                    <!--#region [ ROW -6 ]-->
                    <Border
                        x:Name="bdrSave"
                        Grid.Row="8"
                        Grid.ColumnSpan="3"
                        Height="50"
                        VerticalAlignment="Center"
                        Background="{StaticResource AppButton2}"
                        CornerRadius="8"
                        Mouse.MouseDown="bdrSave_MouseDown">
                        <Label
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Save"
                            FontSize="18"
                            Foreground="{StaticResource PrimaryWhite}"
                            Style="{StaticResource lblSemiBold}" />
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            AutoReverse="False"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0.1"
                                            To="0.9"
                                            Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                    <!--#endregion-->
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
