    xmlns:noti="clr-namespace:eSSLAttendanceDesktopClient.Views.Menu"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <data:IntToBGColorConverter x:Key="statusToBG" />
        <data:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="1"
            Height="70"
            Margin="0,0,0,0"
            Padding="15,0"
            Background="{StaticResource EntBdrBGColor}"
            CornerRadius="8">
            <Border Margin="0" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label
                        VerticalAlignment="Center"
                        Content="Employee"
                        FontSize="20"
                        Style="{StaticResource lblSemiBold}" />

                    <Border
                        x:Name="bdrAddEmployee"
                        Grid.Column="1"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="{StaticResource AppButton2}"
                        BorderThickness="0"
                        CornerRadius="5"
                        Mouse.MouseDown="bdrAddEmployee_MouseDown">
                        <StackPanel Margin="8" Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="20"
                                Source="pack://application:,,,/Images/img_add.png"
                                Stretch="Uniform" />
                            <Label
                                Content="Add Employee"
                                FontSize="18"
                                Style="{StaticResource lblRegular}" />
                        </StackPanel>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            AutoReverse="False"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0.1"
                                            To="0.9"
                                            Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!--#region [ New List ]-->
        <Border
            Grid.Row="6"
            Margin="0"
            Padding="0"
            Background="White"
            CornerRadius="0,0,8,8">
            <Grid>
