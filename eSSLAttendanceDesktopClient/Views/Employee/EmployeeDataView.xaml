                    <DataGrid
                        x:Name="lstEmployee"
                        Margin="0"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        CanUserAddRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeColumns="False"
                        CanUserSortColumns="True"
                        ColumnHeaderStyle="{StaticResource CustomHeaderStyle}"
                        FontFamily="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Medium.ttf#Poppins Medium"
                        FontSize="14"
                        HeadersVisibility="Column"
                        IsHitTestVisible="True">

                        <DataGrid.Columns>
                            <!--  Employee ID  -->
                            <DataGridTemplateColumn Width="250">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock
                                            Margin="0,10,0,10"
                                            FontSize="16"
                                            Foreground="White"
                                            Style="{StaticResource TextBlockRegular}"
                                            Text="Employee ID" />
                                        <Border
                                            Width="200"
                                            Height="40"
                                            Margin="0,0"
                                            Padding="0"
                                            BorderBrush="LightGray"
                                            CornerRadius="5"
                                            Style="{StaticResource bdrAddEmployee}">
                                            <TextBox
                                                x:Name="txtSearchByDeviceUniqueId"
                                                x:Uid="Name"
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                PreviewKeyDown="NumericTextBox_PreviewKeyDown"
                                                PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                Style="{StaticResource addEmpEntry}"
                                                TextChanged="EmployeeIdFilter_TextChanged" />
                                        </Border>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Padding="10"
                                            Style="{StaticResource TextBlockRegular}"
                                            Text="{Binding DeviceUniqueId}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  Name  -->
                            <DataGridTemplateColumn Width="250">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock
                                            Margin="0,10"
                                            FontSize="16"
                                            Foreground="White"
                                            Style="{StaticResource TextBlockRegular}"
                                            Text="Name" />
                                        <Border
                                            Width="200"
                                            Height="40"
                                            Margin="0,0"
                                            Padding="0"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="5"
                                            Style="{StaticResource bdrAddEmployee}">
                                            <TextBox
                                                x:Name="txtSearchByName"
                                                x:Uid="Name"
                                                Height="40"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource addEmpEntry}"
                                                TextChanged="NameFilter_TextChanged" />
                                        </Border>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Padding="10"
                                            Style="{StaticResource TextBlockRegular}"
                                            Text="{Binding Name}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  Department  -->
                            <DataGridTemplateColumn Width="300">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Margin="0,10" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,10"
                                                FontSize="16"
                                                Foreground="White"
                                                Style="{StaticResource TextBlockRegular}"
                                                Text="Department" />
                                            <Image
                                                x:Name="ImgDepartmentReset"
                                                Width="20"
                                                Height="20"
                                                Margin="10,0,0,0"
                                                MouseDown="ImgDepartmentReset_MouseDown"
                                                Source="pack://application:,,,/Images/icon_refresh.png"
                                                Stretch="Uniform">
                                                <Image.Triggers>
                                                    <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    AutoReverse="False"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    From="0.1"
                                                                    To="0.9"
                                                                    Duration="0:0:1" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Image.Triggers>
                                            </Image>
                                        </StackPanel>


                                        <ComboBox
                                            x:Name="CmboxDepartment"
                                            x:Uid="DepartmentId"
                                            Grid.Column="0"
                                            Width="300"
                                            Height="40"
                                            Padding="10,0,0,0"
                                            VerticalAlignment="Stretch"
                                            VerticalContentAlignment="Center"
                                            DisplayMemberPath="Name"
                                            SelectedItem="{Binding SelectedDepartment, Mode=TwoWay}"
                                            SelectionChanged="CmboxDepartment_SelectionChanged"
                                            Style="{StaticResource Cmbox}" />

                                        <TextBlock
                                            x:Name="txtSelectedDepartment"
                                            Grid.Column="0"
                                            Margin="15,-40,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="Black"
                                            IsHitTestVisible="False"
                                            Text="Select Department" />
                                    </StackPanel>

                                    <!--  Visibility="{Binding SelectedDepartment, Converter={StaticResource NullToVisibilityConverter}}"  -->
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Padding="10"
                                            HorizontalAlignment="Left"
                                            Text="{Binding Department}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  Designation  -->
                            <DataGridTemplateColumn Width="300">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,10"
                                                FontSize="16"
                                                Foreground="White"
                                                Style="{StaticResource TextBlockRegular}"
                                                Text="Designation" />

                                            <Image
                                                x:Name="ImgDesignationReset"
                                                Width="20"
                                                Height="20"
                                                Margin="10,0,0,0"
                                                MouseDown="ImgDesignationReset_MouseDown"
                                                Source="pack://application:,,,/Images/icon_refresh.png"
                                                Stretch="Uniform">
                                                <Image.Triggers>
                                                    <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    AutoReverse="False"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    From="0.1"
                                                                    To="0.9"
                                                                    Duration="0:0:1" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Image.Triggers>
                                            </Image>
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="CmboxDesignation"
                                            x:Uid="DesignationId"
                                            Width="250"
                                            Height="40"
                                            Padding="10,0,0,0"
                                            VerticalAlignment="Stretch"
                                            VerticalContentAlignment="Center"
                                            DisplayMemberPath="Name"
                                            SelectionChanged="CmboxDesignation_SelectionChanged"
                                            Style="{StaticResource Cmbox}" />
                                        <TextBlock
                                            x:Name="txtSelectedDesignation"
                                            Margin="15,-40,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="Black"
                                            IsHitTestVisible="False"
                                            Text="Select Designation" />
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Padding="10"
                                            HorizontalAlignment="Left"
                                            Text="{Binding Designation}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  Device  -->
                            <DataGridTemplateColumn Width="250">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock
                                            Margin="0,10"
                                            FontSize="16"
                                            Foreground="White"
                                            Style="{StaticResource TextBlockRegular}"
                                            Text="Device" />
                                        <Border
                                            Width="200"
                                            Height="40"
                                            Margin="0,0"
                                            Padding="0"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="5"
                                            Style="{StaticResource bdrAddEmployee}">
                                            <TextBox
                                                x:Name="txtSearchByDevice"
                                                x:Uid="Name"
                                                Height="40"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource addEmpEntry}"
                                                TextChanged="txtSearchByDevice_TextChanged" />
                                        </Border>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Padding="10"
                                            Style="{StaticResource TextBlockRegular}"
                                            Text="{Binding Device}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  Contact  -->
                            <DataGridTemplateColumn Width="250">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock
                                            Margin="0,10"
                                            FontSize="16"
                                            Foreground="White"
                                            Style="{StaticResource TextBlockRegular}"
                                            Text="Contact" />
                                        <Border
                                            Width="200"
                                            Height="40"
                                            Margin="0,0"
                                            Padding="0"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="5"
                                            Style="{StaticResource bdrAddEmployee}">
                                            <TextBox
                                                x:Name="txtSearchByContact"
                                                x:Uid="Name"
                                                Height="40"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource addEmpEntry}"
                                                TextChanged="txtSearchByContact_TextChanged" />
                                        </Border>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Padding="10"
                                            Style="{StaticResource TextBlockRegular}"
                                            Text="{Binding Contact}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>


                            <!--  Working Hours  -->
                            <DataGridTemplateColumn Width="250">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock
                                            Margin="0,10"
                                            FontSize="16"
                                            Foreground="White"
                                            Style="{StaticResource TextBlockRegular}"
                                            Text="Working Hours" />
                                        <Border
                                            Width="200"
                                            Height="40"
                                            Margin="0,0"
                                            Padding="0"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="5"
                                            Style="{StaticResource bdrAddEmployee}"
                                            Visibility="Hidden">
                                            <TextBox
                                                x:Name="txtSearchByWorkingHours"
                                                x:Uid="Name"
                                                Height="40"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource addEmpEntry}" />
                                        </Border>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Padding="10"
                                            Style="{StaticResource TextBlockRegular}"
                                            Text="{Binding WorkingHours}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  Action Column  -->
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock
                                            Margin="0,10"
                                            HorizontalAlignment="Center"
                                            FontSize="16"
                                            Foreground="White"
                                            Style="{StaticResource TextBlockRegular}"
                                            Text="Action" />

                                        <Border
                                            Height="40"
                                            BorderBrush="LightGray"
                                            BorderThickness="2"
                                            Style="{StaticResource bdrAddEmployee}"
                                            Visibility="Hidden">
                                            <TextBox
                                                x:Name="txtAction"
                                                x:Uid="Name"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource addEmpEntry}" />
                                        </Border>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Grid.Column="0"
                                                Width="30"
                                                Height="30"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#FFC507"
                                                BorderThickness="0"
                                                CornerRadius="5">
                                                <Image
                                                    Width="20"
                                                    Height="20"
                                                    Mouse.MouseDown="BtnEdit_MouseDown"
                                                    Source="pack://application:,,,/Images/icon_edit.png" />
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    AutoReverse="False"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    From="0.1"
                                                                    To="0.9"
                                                                    Duration="0:0:1" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>

                                            </Border>

                                            <Border
                                                Grid.Column="2"
                                                Width="30"
                                                Height="30"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#EC0A14"
                                                BorderThickness="0"
                                                CornerRadius="5">
                                                <Image
                                                    Width="20"
                                                    Height="20"
                                                    Mouse.MouseDown="BtnDelete_MouseDown"
                                                    Source="pack://application:,,,/Images/icon_delete.png" />
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    AutoReverse="False"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    From="0.1"
                                                                    To="0.9"
                                                                    Duration="0:0:1" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                            </Border>

                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>

                <TextBlock
                    x:Name="lblRecordNotfound"
                    Grid.Row="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Foreground="Black"
                    Style="{StaticResource TextBlockRegular}"
                    Text="Record not found!"
                    Visibility="Hidden" />

            </Grid>
        </Border>
        <!--#endregion-->

        <Grid Grid.Row="9" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>


            <Label
                x:Name="lblShowingRecords"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Content="Showing 1 to 2 of 10 Record"
                FontSize="16"
                Foreground="Black"
                Style="{StaticResource lblMedium}" />

            <!--<ComboBox
                x:Name="cmbPageNumbers"
                Grid.Column="1"
                Width="100"
                Margin="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="Black"
                SelectionChanged="cmbPageNumbers_SelectionChanged" />-->
            <!--  ComboBox  -->
            <ComboBox
                x:Name="EntriesPerPageComboBox"
                Grid.Column="1"
                Width="80"
                Height="30"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                SelectedIndex="1"
                SelectionChanged="EntriesPerPageComboBox_SelectionChanged">
                <ComboBoxItem Content="5" />
                <ComboBoxItem Content="10" />
                <ComboBoxItem Content="20" />
                <ComboBoxItem Content="50" />
                <ComboBoxItem Content="100" />
                <ComboBoxItem Content="All" />
            </ComboBox>

            <Border
                x:Name="btnPrevious"
                Grid.Column="3"
                Width="80"
                Height="30"
                CornerRadius="8"
                Mouse.MouseDown="btnPrevious_MouseDown">
                <Label
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{StaticResource AppButton2}"
                    Content="Previous"
                    Style="{StaticResource lblMedium}" />
                <Border.Triggers>
                    <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    AutoReverse="False"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0.1"
                                    To="0.9"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>

            <Border
                Grid.Column="5"
                Width="50"
                Height="30"
                Padding="0"
                Background="{StaticResource BGColor}"
                CornerRadius="5">
                <Label
                    x:Name="lblCurrentPageValue"
                    HorizontalContentAlignment="Center"
                    Style="{StaticResource lblMedium}" />
            </Border>

            <Border
                x:Name="btnNext"
                Grid.Column="7"
                Width="80"
                Height="30"
                CornerRadius="10"
                Mouse.MouseDown="btnNext_MouseDown">
                <Label
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{StaticResource AppButton2}"
                    Content="Next"
                    Style="{StaticResource lblMedium}" />
                <Border.Triggers>
                    <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    AutoReverse="False"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0.1"
                                    To="0.9"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
        </Grid>
    </Grid>
</UserControl>
