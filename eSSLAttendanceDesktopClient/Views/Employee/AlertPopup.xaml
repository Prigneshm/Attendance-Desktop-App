<Window
    x:Class="eSSLAttendanceDesktopClient.Views.Employee.AlertPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:eSSLAttendanceDesktopClient.Views.Employee"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Alert"
    Width="500"
    Height="200"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    mc:Ignorable="d">
    <!--#region [ Navigation ]-->
    <Grid Margin="0,0,0,0">
        <Border
            Grid.Row="1"
            Padding="10"
            BorderThickness="0"
            CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Label
                    x:Name="TitleMessage"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Content="Are you sure want to delete this record."
                    FontSize="18"
                    Foreground="Black"
                    Style="{StaticResource lblRegular}" />

                <Button
                    x:Name="BtnYes"
                    Grid.Row="2"
                    Grid.Column="0"
                    Height="40"
                    VerticalAlignment="Bottom"
                    Click="BtnYes_Click"
                    Content="Yes"
                    Style="{StaticResource PrimaryButton}" />

                <Button
                    x:Name="BtnNo"
                    Grid.Row="2"
                    Grid.Column="2"
                    Height="40"
                    VerticalAlignment="Bottom"
                    Background="#DC515C"
                    Click="BtnNo_Clicked"
                    Content="No">
                    <Button.Style>
                        <Style BasedOn="{StaticResource PrimaryButton}" TargetType="Button">
                            <Style.Triggers>
                                <!--  Override hover behavior  -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#DC515C" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>


            </Grid>
        </Border>
        <!--<Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

        -->
        <!--<Grid
                    Grid.Row="0"
                    Margin="0"
                    Background="{StaticResource AppButton2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label
                        x:Name="lblTitle"
                        Grid.Column="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="Alert"
                        FontSize="18"

                        Foreground="{StaticResource PrimaryWhite}"
                        Style="{StaticResource lblSemiBold}" />
                    <Image
                        x:Name="imgClose"
                        Grid.Column="1"
                        Width="30"
                        Height="30"
                        Margin="0,0,8,0"
                        MouseDown="imgClose_MouseDown"
                        Source="pack://application:,,,/Images/icon_close.png" />
                </Grid>-->
        <!--#endregion-->
        <!--
            </Grid>-->
    </Grid>
</Window>
