<Window
    x:Class="eSSLAttendanceDesktopClient.Views.Attendance.CreateAttendanceLogWindows"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:eSSLAttendanceDesktopClient.Views.Attendance"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfToolkit="http://schemas.xceed.com/wpf/xaml/toolkit"
    Width="800"
    Height="450"
    BorderThickness="0"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--#region [ Navigation ]-->
        <Border
            Grid.Row="0"
            Padding="5,0"
            Background="{StaticResource AppButton2}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label
                    x:Name="lblTitle"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Content="Add Attendance Log"
                    FontSize="16"
                    Foreground="{StaticResource PrimaryWhite}"
                    Style="{StaticResource lblSemiBold}" />
                <Image
                    x:Name="imgClose"
                    Grid.Column="1"
                    Width="30"
                    Height="30"
                    Margin="0"
                    HorizontalAlignment="Right"
                    Mouse.MouseDown="imgClose_MouseDown"
                    Source="pack://application:,,,/Images/icon_close.png"
                    Visibility="Hidden" />
            </Grid>
        </Border>
        <!--#endregion-->

        <Grid Grid.Row="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--#region [ ROW - 0 ]-->
            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3">
                <StackPanel Orientation="Horizontal">
                    <Label
                        Content="Select Employee"
                        FontSize="16"
                        Foreground="{StaticResource BgColor}"
                        Style="{StaticResource lblSemiBold}" />
                    <Label
                        Content="*"
                        FontSize="15"
                        Style="{StaticResource lblSemiBold}" />
                </StackPanel>
                <Border
                    Margin="0,0"
                    BorderBrush="LightGray"
                    BorderThickness="2"
                    Style="{StaticResource bdrAddEmployee}">
                    <ComboBox
                        x:Name="CmboxEmployeeId"
                        x:Uid="CheckIn"
                        Padding="10,0,0,0"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                        DisplayMemberPath="EmployeeName"
                        SelectionChanged="CmboxEmployeeId_SelectionChanged"
                        Style="{StaticResource Cmbox}" />
                </Border>
                <TextBlock
                    x:Name="EreEmployeeId"
                    Foreground="Red"
                    Style="{StaticResource TextBlockRegular}"
                    Text="Please select employee name"
                    Visibility="Hidden" />
            </StackPanel>
            <!--#endregion-->

            <!--#region [ ROW - 2 ]-->
            <StackPanel Grid.Row="2" Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <Label
                        Content="Select Check-In Time"
                        FontSize="16"
                        Foreground="{StaticResource BgColor}"
                        Style="{StaticResource lblSemiBold}" />
                    <Label
                        Content="*"
                        FontSize="15"
                        Foreground="red"
                        Style="{StaticResource lblSemiBold}" />
                </StackPanel>
                <Border
                    Margin="0,0"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="0"
                    Style="{StaticResource bdrAddEmployee}">
                    <!--<materialDesign:TimePicker
                        x:Name="TmPckCheckInTime"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                        Style="{StaticResource mateTimePicker}" />-->
                    <wpfToolkit:DateTimePicker
                        x:Name="dateTimePickerCheckIn"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        materialDesign:CalendarAssist.IsHeaderVisible="True"
                        AllowTextInput="False"
                        AutoCloseCalendar="True"
                        DisplayDefaultValueOnEmptyText="True"
                        FontFamily="Cascadia Mono"
                        FontSize="18"
                        Format="Custom"
                        FormatString="dd-MM-yyyy hh:mm tt"
                        ShowButtonSpinner="True"
                        ShowDropDownButton="True"
                        TextAlignment="Justify"
                        TimePickerShowButtonSpinner="True"
                        ValueChanged="dateTimePickerCheckIn_ValueChanged" />

                    <!--<DatePicker VerticalAlignment="Center" FontSize="18">
                        <DatePicker.CalendarStyle>
                            <Style BasedOn="{StaticResource MaterialDesignDatePickerCalendarPortrait}" TargetType="Calendar">
                                <Style.Resources>
                                    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#FF0099CC" />
                                </Style.Resources>
                            </Style>
                        </DatePicker.CalendarStyle>
                    </DatePicker>-->

                </Border>
                <TextBlock
                    x:Name="EreCheckIn"
                    Foreground="Red"
                    Style="{StaticResource TextBlockRegular}"
                    Text="Please select check-in time"
                    Visibility="Hidden" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="2">
                <StackPanel Orientation="Horizontal">
                    <Label
                        Content="Select Check-Out Time"
                        FontSize="16"
                        Foreground="{StaticResource BgColor}"
                        Style="{StaticResource lblSemiBold}" />
                    <Label
                        Content="*"
                        FontSize="15"
                        Foreground="red"
                        Style="{StaticResource lblSemiBold}" />
                </StackPanel>
                <Border
                    x:Name="bdrCheckOut"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="0"
                    Style="{StaticResource bdrAddEmployee}">
                    <!--<materialDesign:TimePicker
                        x:Name="TmPckCheckOutTime"
                        VerticalAlignment="Center"
                        materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                        Style="{StaticResource mateTimePicker}" />-->

                    <wpfToolkit:DateTimePicker
                        x:Name="dateTimePickerCheckOut"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        DisplayDefaultValueOnEmptyText="False"
                        FontFamily="Cascadia Mono"
                        FontSize="18"
                        Format="Custom"
                        FormatString="dd-MM-yyyy hh:mm tt"
                        ShowButtonSpinner="True"
                        ShowDropDownButton="True"
                        TextAlignment="Justify"
                        ValueChanged="dateTimePickerCheckOut_ValueChanged" />
                </Border>

                <TextBlock
                    x:Name="EreCheckOut"
                    Foreground="Red"
                    Style="{StaticResource TextBlockRegular}"
                    Text="Please select check-out time"
                    Visibility="Hidden" />
            </StackPanel>
            <!--#endregion-->

            <!--#region [ ROW - 4 ]-->
            <Border
                x:Name="bdrSave"
                Grid.Row="4"
                Grid.ColumnSpan="3"
                Height="50"
                VerticalAlignment="Center"
                Background="{StaticResource AppButton2}"
                CornerRadius="8"
                Mouse.MouseDown="bdrSave_MouseDown">
                <Label
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Save"
                    FontSize="18"
                    Foreground="{StaticResource PrimaryWhite}"
                    Style="{StaticResource lblSemiBold}" />
                <Border.Triggers>
                    <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    AutoReverse="False"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0.1"
                                    To="0.9"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
            <!--#endregion-->
        </Grid>
    </Grid>
</Window>
