<UserControl
    x:Class="eSSLAttendanceDesktopClient.Views.Attendance.AttendanceLogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Snackbar="clr-namespace:eSSLAttendanceDesktopClient.Utility"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:eSSLAttendanceDesktopClient.Converter"
    xmlns:local="clr-namespace:eSSLAttendanceDesktopClient.Views.Attendance"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <data:IntToBGColorConverter x:Key="statusToBG" />
        <data:StatusToBGColorConverter x:Key="StatusToBGColorConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--#region [ Navigation Grid Row - 1]-->
        <Border
            Grid.Row="1"
            Height="70"
            Margin="0,0,0,0"
            Padding="15,0"
            Background="{StaticResource EntBdrBGColor}"
            CornerRadius="8">
            <Border Margin="0" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label
                        VerticalAlignment="Center"
                        Content="Attendance Log"
                        FontSize="20"
                        Style="{StaticResource lblSemiBold}" />
                    <Image
                        x:Name="imgCheckBox"
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        Mouse.MouseDown="bdrAddAttendance_MouseDown"
                        Source="pack://application:,,,/Images/icon_csv.png"
                        Stretch="Uniform" />
                    <!--<Border
                        x:Name="bdrAddAttendance"

                        Padding="0"
                        VerticalAlignment="Center"
                        Background="{StaticResource AppButton2}"
                        BorderThickness="0"
                        CornerRadius="5"
                        Mouse.MouseDown="bdrAddAttendance_MouseDown"
                        Visibility="Visible">
                        <StackPanel Margin="8" Orientation="Horizontal">
                    -->
                    <!--<Image
                                Width="20"
                                Height="20"
                                Source="pack://application:,,,/Images/img_add.png"
                                Stretch="Uniform"
                                Visibility="Hidden" />-->
                    <!--

                        </StackPanel>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            AutoReverse="False"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0.1"
                                            To="0.9"
                                            Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>-->
                </Grid>
            </Border>
        </Border>
        <!--#endregion-->

        <!--#region [ Attendance Log List Row - 7]-->
        <Grid Grid.Row="5" Background="White">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid
                    x:Name="lstAttendanceLogs"
                    Margin="0"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    CanUserAddRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="False"
                    CanUserSortColumns="True"
                    ColumnHeaderStyle="{StaticResource CustomHeaderStyle}"
                    FontFamily="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Medium.ttf#Poppins Medium"
                    FontSize="14"
                    HeadersVisibility="Column"
                    IsHitTestVisible="True">

                    <DataGrid.Columns>
                        <!--  Department  -->
                        <DataGridTemplateColumn Width="300">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Margin="0,10" Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,10,0,10"
                                            FontSize="16"
                                            Foreground="White"
                                            Style="{StaticResource TextBlockRegular}"
                                            Text="Department" />
                                        <Image
                                            x:Name="ImgDepartmentReset"
                                            Width="20"
                                            Height="20"
                                            Margin="10,0,0,0"
                                            MouseDown="ImgDepartmentReset_MouseDown"
                                            Source="pack://application:,,,/Images/icon_refresh.png"
                                            Stretch="Uniform">
                                            <Image.Triggers>
                                                <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                AutoReverse="False"
                                                                Storyboard.TargetProperty="Opacity"
                                                                From="0.1"
                                                                To="0.9"
                                                                Duration="0:0:1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Image.Triggers>
                                        </Image>

                                    </StackPanel>
                                    <ComboBox
                                        x:Name="CmboxDepartment"
                                        x:Uid="DepartmentId"
                                        Width="280"
                                        Height="40"
                                        Padding="10,0,0,0"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        DisplayMemberPath="Name"
                                        SelectedItem="{Binding SelectedDepartment, Mode=TwoWay}"
                                        SelectionChanged="CmboxDepartment_SelectionChanged"
                                        Style="{StaticResource Cmbox}" />
                                    <TextBlock
                                        x:Name="txtSelectedDepartment"
                                        Margin="15,-40,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="Black"
                                        IsHitTestVisible="False"
                                        Text="Select Department" />
                                </StackPanel>
                                <!--  Visibility="{Binding SelectedDepartment, Converter={StaticResource NullToVisibilityConverter}}"  -->
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="10"
                                        HorizontalAlignment="Left"
                                        Text="{Binding Department}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  Designation  -->
                        <DataGridTemplateColumn Width="300">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,10"
                                            FontSize="16"
                                            Foreground="White"
                                            Style="{StaticResource TextBlockRegular}"
                                            Text="Designation" />

                                        <Image
                                            x:Name="ImgDesignationReset"
                                            Width="20"
                                            Height="20"
                                            Margin="10,0,0,0"
                                            MouseDown="ImgDesignationReset_MouseDown"
                                            Source="pack://application:,,,/Images/icon_refresh.png"
                                            Stretch="Uniform">
                                            <Image.Triggers>
                                                <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                AutoReverse="False"
                                                                Storyboard.TargetProperty="Opacity"
                                                                From="0.1"
                                                                To="0.9"
                                                                Duration="0:0:1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Image.Triggers>
                                        </Image>
                                    </StackPanel>
                                    <ComboBox
                                        x:Name="CmboxDesignation"
                                        x:Uid="DesignationId"
                                        Width="250"
                                        Height="40"
                                        Padding="10,0,0,0"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        DisplayMemberPath="Name"
                                        SelectionChanged="CmboxDesignation_SelectionChanged"
                                        Style="{StaticResource Cmbox}" />
                                    <TextBlock
                                        x:Name="txtSelectedDesignation"
                                        Margin="15,-40,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="Black"
                                        IsHitTestVisible="False"
                                        Text="Select Designation" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="10"
                                        HorizontalAlignment="Left"
                                        Text="{Binding Designation}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  Employee Name  -->
                        <DataGridTemplateColumn Width="250">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock
                                        Margin="0,10,0,10"
                                        FontSize="16"
                                        Foreground="White"
                                        Style="{StaticResource TextBlockRegular}"
                                        Text="Employee Name" />
                                    <Border
                                        Width="200"
                                        Height="40"
                                        Margin="0,0"
                                        Padding="0"
                                        BorderBrush="LightGray"
                                        CornerRadius="5"
                                        Style="{StaticResource bdrAddEmployee}">
                                        <TextBox
                                            x:Name="txtSearchByName"
                                            x:Uid="Name"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource addEmpEntry}"
                                            TextChanged="EmployeeNameFilter_TextChanged" />
                                    </Border>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="10"
                                        Style="{StaticResource TextBlockRegular}"
                                        Text="{Binding EmployeeName}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  Check-In  -->
                        <DataGridTemplateColumn Width="250">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,10"
                                            FontSize="16"
                                            Foreground="White"
                                            Style="{StaticResource TextBlockRegular}"
                                            Text="Check-In" />
                                        <Image
                                            x:Name="ImgCheckInDateReset"
                                            Width="20"
                                            Height="20"
                                            Margin="10,0,0,0"
                                            MouseDown="ImgCheckInDateReset_MouseDown"
                                            Source="pack://application:,,,/Images/icon_refresh.png"
                                            Stretch="Uniform">
                                            <Image.Triggers>
                                                <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                AutoReverse="False"
                                                                Storyboard.TargetProperty="Opacity"
                                                                From="0.1"
                                                                To="0.9"
                                                                Duration="0:0:1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Image.Triggers>
                                        </Image>
                                    </StackPanel>
                                    <Border
                                        Width="200"
                                        Height="40"
                                        Margin="0"
                                        BorderBrush="LightGray"
                                        BorderThickness="2"
                                        Style="{StaticResource bdrAddEmployee}">
                                        <DatePicker
                                            x:Name="dtFrom"
                                            Margin="5,0"
                                            VerticalAlignment="Bottom"
                                            VerticalContentAlignment="Center"
                                            materialDesign:HintAssist.Hint="From Date"
                                            BorderBrush="Transparent"
                                            SelectedDateChanged="dtFrom_SelectedDateChanged"
                                            Style="{StaticResource mateDatePicker}">
                                            <DatePicker.CalendarStyle>
                                                <Style BasedOn="{StaticResource MaterialDesignCalendarPortraitForeground}" TargetType="Calendar" />
                                            </DatePicker.CalendarStyle>
                                        </DatePicker>
                                    </Border>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="10"
                                        Style="{StaticResource TextBlockRegular}"
                                        Text="{Binding CheckIn}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  Check-Out  -->
                        <DataGridTemplateColumn Width="250">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,10"
                                            FontSize="16"
                                            Foreground="White"
                                            Style="{StaticResource TextBlockRegular}"
                                            Text="Check-Out" />
                                        <Image
                                            x:Name="ImgCheckOutDateReset"
                                            Width="20"
                                            Height="20"
                                            Margin="10,0,0,0"
                                            MouseDown="ImgCheckOutDateReset_MouseDown"
                                            Source="pack://application:,,,/Images/icon_refresh.png"
                                            Stretch="Uniform">
                                            <Image.Triggers>
                                                <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                AutoReverse="False"
                                                                Storyboard.TargetProperty="Opacity"
                                                                From="0.1"
                                                                To="0.9"
                                                                Duration="0:0:1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Image.Triggers>
                                        </Image>
                                    </StackPanel>
                                    <Border
                                        Width="200"
                                        Height="40"
                                        Margin="0"
                                        BorderBrush="LightGray"
                                        BorderThickness="2"
                                        Style="{StaticResource bdrAddEmployee}">
                                        <DatePicker
                                            x:Name="toDate"
                                            Margin="5,0"
                                            VerticalAlignment="Bottom"
                                            VerticalContentAlignment="Center"
                                            materialDesign:HintAssist.Hint="From Date"
                                            BorderBrush="Transparent"
                                            SelectedDateChanged="toDate_SelectedDateChanged"
                                            Style="{StaticResource mateDatePicker}">
                                            <DatePicker.CalendarStyle>
                                                <Style BasedOn="{StaticResource MaterialDesignCalendarPortraitForeground}" TargetType="Calendar" />
                                            </DatePicker.CalendarStyle>
                                        </DatePicker>
                                    </Border>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="10"
                                        Style="{StaticResource TextBlockRegular}"
                                        Text="{Binding CheckOut}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  Working Hours  -->
                        <DataGridTemplateColumn Width="250">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock
                                        Margin="0,10"
                                        FontSize="16"
                                        Foreground="White"
                                        Style="{StaticResource TextBlockRegular}"
                                        Text="Working Time" />
                                    <Border
                                        Width="200"
                                        Height="40"
                                        Margin="0,0"
                                        Padding="0"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="5"
                                        Style="{StaticResource bdrAddEmployee}"
                                        Visibility="Hidden">
                                        <TextBox
                                            x:Name="txtSearchByContact"
                                            x:Uid="Name"
                                            Height="40"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource addEmpEntry}" />
                                    </Border>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="10"
                                        Style="{StaticResource TextBlockRegular}"
                                        Text="{Binding WorkingHoursFormatted}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  OverTime  -->
                        <DataGridTemplateColumn Width="250">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock
                                        Margin="0,10"
                                        FontSize="16"
                                        Foreground="White"
                                        Style="{StaticResource TextBlockRegular}"
                                        Text="Over Time" />
                                    <Border
                                        Width="200"
                                        Height="40"
                                        Margin="0,0"
                                        Padding="0"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="5"
                                        Style="{StaticResource bdrAddEmployee}"
                                        Visibility="Hidden">
                                        <TextBox
                                            Height="40"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource addEmpEntry}" />
                                    </Border>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="10"
                                        Style="{StaticResource TextBlockRegular}"
                                        Text="{Binding OvertimeFormatted}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  Status  -->
                        <DataGridTemplateColumn Width="250">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock
                                        Margin="0,10"
                                        FontSize="16"
                                        Foreground="White"
                                        Style="{StaticResource TextBlockRegular}"
                                        Text="Status" />
                                    <Border
                                        Width="200"
                                        Height="40"
                                        Margin="0,0"
                                        Padding="0"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="5"
                                        Style="{StaticResource bdrAddEmployee}">
                                        <TextBox
                                            x:Name="txtSearchByStatus"
                                            x:Uid="Name"
                                            Height="40"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource addEmpEntry}"
                                            TextChanged="txtSearchByStatus_TextChanged" />
                                    </Border>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="10"
                                        Style="{StaticResource TextBlockRegular}"
                                        Text="{Binding Status}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  Action Column  -->
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock
                                        Margin="0,10"
                                        HorizontalAlignment="Center"
                                        FontSize="16"
                                        Foreground="White"
                                        Style="{StaticResource TextBlockRegular}"
                                        Text="Action" />

                                    <Border
                                        Height="40"
                                        BorderBrush="LightGray"
                                        BorderThickness="2"
                                        Style="{StaticResource bdrAddEmployee}"
                                        Visibility="Hidden">
                                        <TextBox
                                            x:Name="txtAction"
                                            x:Uid="Name"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource addEmpEntry}" />
                                    </Border>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Width="30"
                                            Height="30"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#FFC507"
                                            BorderThickness="0"
                                            CornerRadius="5"
                                            Mouse.MouseDown="BtnEdit_MouseDown">
                                            <Image
                                                Width="20"
                                                Height="20"
                                                Source="pack://application:,,,/Images/icon_edit.png" />
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                AutoReverse="False"
                                                                Storyboard.TargetProperty="Opacity"
                                                                From="0.1"
                                                                To="0.9"
                                                                Duration="0:0:1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>

                                        </Border>

                                        <Border
                                            Grid.Column="2"
                                            Width="30"
                                            Height="30"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#EC0A14"
                                            BorderThickness="0"
                                            CornerRadius="5"
                                            Mouse.MouseDown="BtnDelete_MouseDown">
                                            <Image
                                                Width="20"
                                                Height="20"
                                                Source="pack://application:,,,/Images/icon_delete.png" />
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                AutoReverse="False"
                                                                Storyboard.TargetProperty="Opacity"
                                                                From="0.1"
                                                                To="0.9"
                                                                Duration="0:0:1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
            <TextBlock
                x:Name="lblRecordNotfound"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="20"
                Foreground="Black"
                Style="{StaticResource TextBlockRegular}"
                Text="Record not found!"
                Visibility="Hidden" />
        </Grid>

        <!--#endregion-->

        <!--#region [ Pagination  Row - 9 ]-->
        <Grid Grid.Row="9" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label
                x:Name="lblShowingRecords"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Content="Showing 1 to 2 of 10 Record"
                FontSize="16"
                Foreground="Black"
                Style="{StaticResource lblMedium}" />

            <!--<ComboBox
                x:Name="cmbPageNumbers"
                Grid.Column="1"
                Width="100"
                Margin="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="Black"
                SelectionChanged="cmbPageNumbers_SelectionChanged" />-->

            <!--  ComboBox  -->
            <ComboBox
                x:Name="EntriesPerPageComboBox"
                Grid.Column="1"
                Width="80"
                Height="30"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                SelectedIndex="1"
                SelectionChanged="EntriesPerPageComboBox_SelectionChanged">
                <ComboBoxItem Content="5" />
                <ComboBoxItem Content="10" />
                <ComboBoxItem Content="20" />
                <ComboBoxItem Content="50" />
                <ComboBoxItem Content="100" />
                <ComboBoxItem Content="All" />
            </ComboBox>

            <Border
                x:Name="btnPrevious"
                Grid.Column="3"
                Width="80"
                Height="30"
                CornerRadius="8"
                Mouse.MouseDown="btnPrevious_MouseDown">
                <Label
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{StaticResource AppButton2}"
                    Content="Previous"
                    Style="{StaticResource lblMedium}" />
                <Border.Triggers>
                    <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    AutoReverse="False"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0.1"
                                    To="0.9"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>

            <Border
                Grid.Column="5"
                Width="70"
                Height="30"
                Padding="0"
                Background="{StaticResource BGColor}"
                CornerRadius="5">
                <Label
                    x:Name="lblCurrentPageValue"
                    HorizontalContentAlignment="Center"
                    Style="{StaticResource lblMedium}" />
            </Border>

            <Border
                x:Name="btnNext"
                Grid.Column="7"
                Width="80"
                Height="30"
                CornerRadius="10"
                Mouse.MouseDown="btnNext_MouseDown">
                <Label
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{StaticResource AppButton2}"
                    Content="Next"
                    Style="{StaticResource lblMedium}" />
                <Border.Triggers>
                    <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    AutoReverse="False"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0.1"
                                    To="0.9"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>

        </Grid>
        <!--#endregion-->

        <materialDesign:Snackbar
            Grid.RowSpan="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            MessageQueue="{x:Static Snackbar:SnackbarService.GlobalMessageQueue}" />
    </Grid>
</UserControl>
