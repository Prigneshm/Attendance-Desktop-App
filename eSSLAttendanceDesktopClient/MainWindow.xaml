<Window
    x:Class="eSSLAttendanceDesktopClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Notifications.Wpf.Controls;assembly=Notifications.Wpf"
    xmlns:converter="clr-namespace:eSSLAttendanceDesktopClient.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:eSSLAttendanceDesktopClient"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpf="clr-namespace:Notifications.Wpf;assembly=Notifications.Wpf"
    Title="eSSLAttendanceDesktop"
    WindowState="Maximized"
    mc:Ignorable="d">
    <!--
        Width="800"
        Height="450"
    -->
    <Window.Resources>
        <converter:IntToBGColorConverter x:Key="IntToColorConverter" />
    </Window.Resources>
    <Grid>
        <Frame Name="MainFrame" NavigationUIVisibility="Hidden" />
    </Grid>
</Window>
