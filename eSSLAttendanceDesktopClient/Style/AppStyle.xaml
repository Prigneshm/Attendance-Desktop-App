<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:util="clr-namespace:eSSLAttendanceDesktopClient.Utility"
    xmlns:wpfToolkit="http://schemas.xceed.com/wpf/xaml/toolkit">

    <!--<Setter Property="Background" Value="#0BA6F2" />-->
    <Style x:Key="CustomHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#444444" />
        <Setter Property="FontWeight" Value="SemiBold" />

        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="lblSemiBold" TargetType="Label">
        <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-SemiBold.ttf#Poppins SemiBold" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="lblRegular" TargetType="Label">
        <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Regular.ttf#Poppins Regular" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="lblMedium" TargetType="Label">
        <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Medium.ttf#Poppins Medium" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="bdrAddEmployee" TargetType="Border">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="50" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{StaticResource PrimaryWhite}" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AppButton2}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryWhite}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Height" Value="50" />
        <Setter Property="FontFamily" Value="SemiBold" />
    </Style>

    <Style x:Key="extEntry" TargetType="TextBox">
        <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Regular.ttf#Poppins Regular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryWhite}" />
    </Style>

    <Style x:Key="addEmpEntry" TargetType="TextBox">

        <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Regular.ttf#Poppins Regular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="Black" />
    </Style>

    <Style x:Key="lblLstRegular" TargetType="Label">
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Medium.ttf#Poppins Medium" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="TextBlockRegular" TargetType="TextBlock">
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Medium.ttf#Poppins Medium" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="15" />
    </Style>


    <Style x:Key="Cmbox" TargetType="ComboBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Medium.ttf#Poppins Medium" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="0">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource MaterialDesignDatePicker}" TargetType="DatePicker">
        <Setter Property="Foreground" Value="Teal" />
    </Style>

    <Style x:Key="mateTimePicker" TargetType="{x:Type materialDesign:TimePicker}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Background" Value="Teal" />
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Medium.ttf#Poppins Medium" />
        <Setter Property="Foreground" Value="Black" />
        <!--  Border color when not focused  -->
        <Setter Property="BorderBrush" Value="Transparent" />
        <!--  Set the FocusedBrush to Transparent  -->
        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="Transparent" />
    </Style>

    <Style x:Key="mateDatePicker" TargetType="{x:Type DatePicker}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Regular.ttf#Poppins Regular" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="Transparent" />
    </Style>


    <!--<Style TargetType="materialDesign:Snackbar">
        <Setter Property="Background" Value="Gray" />
        <Style.Triggers>
            <DataTrigger Binding="{x:Static util:SnackbarService.MessageType}" Value="Error">
                <Setter Property="Background" Value="Red" />
            </DataTrigger>

        </Style.Triggers>
    </Style>-->

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Padding" Value="10" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Regular.ttf#Poppins Regular" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="Transparent" />
    </Style>
</ResourceDictionary>