<UserControl
    x:Class="eSSLAttendanceDesktopClient.CustomeControl.CustomLoader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gif="http://wpfanimatedgif.codeplex.com"
    xmlns:local="clr-namespace:eSSLAttendanceDesktopClient.CustomeControl"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="#70000000"
    mc:Ignorable="d">
    <Grid Width="110" Height="110">
        <Border
            Width="110"
            Height="110"
            Margin="0"
            Padding="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource BGColor}"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--<materialDesign:Card Padding="5" UniformCornerRadius="10">
            <StackPanel>
                <ProgressBar
                    Width="70"
                    Height="70"
                    BorderThickness="10"
                    Foreground="DeepSkyBlue"
                    IsIndeterminate="True"
                    Style="{StaticResource MaterialDesignCircularProgressBar}"
                    Value="80" />
                <TextBlock
                    Margin="5"
                    HorizontalAlignment="Center"
                    FontSize="15"
                    Foreground="Black"
                    Style="{StaticResource TextBlockRegular}"
                    Text="Loading..." />
            </StackPanel>
        </materialDesign:Card>-->

                <Image
                    x:Name="loaderImage"
                    Width="80"
                    Height="80"
                    gif:ImageBehavior.AnimateInDesignMode="False"
                    gif:ImageBehavior.AnimatedSource="/Images/Shree_Nandeshwar_Loader.gif"
                    gif:ImageBehavior.AnimationSpeedRatio="5"
                    gif:ImageBehavior.AutoStart="True" />


                <!--<mediaelement
                    x:name="loaderimage"
                    loadedbehavior="play"
                    source="Images/Shree_Nandeshwar_Loader.gif" />-->

                <!--<Image gif:ImageBehavior.AnimatedSource="pack://application:,,,/eSSLAttendanceDesktopClient;component/Images/Shree_Nandeshwar_Loader.gif" Stretch="Uniform" />-->


                <Label
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalContentAlignment="Bottom"
                    Content="Loading..."
                    FontSize="15"
                    Foreground="White"
                    Style="{StaticResource lblLstRegular}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
