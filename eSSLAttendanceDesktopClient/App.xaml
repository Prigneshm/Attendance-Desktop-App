<Application
    x:Class="eSSLAttendanceDesktopClient.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:eSSLAttendanceDesktopClient"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.DeepPurple.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <ResourceDictionary Source="/Style/ColorStyle.xaml" />
                <ResourceDictionary Source="/Style/AppStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <!--<SolidColorBrush x:Key="PrimaryWhite">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="AppButton">#0B77A6</SolidColorBrush>
        <SolidColorBrush x:Key="AppButton2">#0BA6F2</SolidColorBrush>
        <SolidColorBrush x:Key="EntBdrBGColor">#444444</SolidColorBrush>
        <SolidColorBrush x:Key="BgColor">#110D0E</SolidColorBrush>
        <SolidColorBrush x:Key="lblLstColor">#000000</SolidColorBrush>
        <SolidColorBrush x:Key="lstBGColor">#D0D0D0</SolidColorBrush>
        <SolidColorBrush x:Key="BGColor">#444444</SolidColorBrush>
        <SolidColorBrush x:Key="lstFirstRowColor">#F5F5F5</SolidColorBrush>
        <SolidColorBrush x:Key="lstSecondRowColor">#E6E6E6</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryBorderBrush" Color="#FF0099CC" />

        <Style x:Key="lblSemiBold" TargetType="Label">
            <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-SemiBold.ttf#Poppins SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="lblRegular" TargetType="Label">
            <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Regular.ttf#Poppins Regular" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="lblMedium" TargetType="Label">
            <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Medium.ttf#Poppins Medium" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="bdrAddEmployee" TargetType="Border">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="50" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource PrimaryWhite}" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AppButton2}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryWhite}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Height" Value="50" />
            <Setter Property="FontFamily" Value="SemiBold" />
        </Style>

        <Style x:Key="extEntry" TargetType="TextBox">
            <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Regular.ttf#Poppins Regular" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryWhite}" />
        </Style>

        <Style x:Key="addEmpEntry" TargetType="TextBox">

            <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Regular.ttf#Poppins Regular" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="Black" />
        </Style>

        <Style x:Key="lblLstRegular" TargetType="Label">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Medium.ttf#Poppins Medium" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="TextBlockRegular" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Medium.ttf#Poppins Medium" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="Cmbox" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="pack://application:,,,/eSSLAttendanceDesktopClient;component/Fonts/Poppins-Medium.ttf#Poppins Medium" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>-->

    </Application.Resources>
</Application>
